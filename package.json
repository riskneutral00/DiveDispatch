{
  "name": "dive-dispatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "car": "bash scripts/car.sh",
    "dev": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "npm run seed:force",
    "seed:force": "npx convex run seed:wipeAll && npx convex dev --once && npx convex run seed:seedAll && tsx scripts/seed-clerk.ts --force && npx convex run seed:seedVerify",
    "seed:clerk": "tsx scripts/seed-clerk.ts",
    "seed:force:all": "npm run seed:force",
    "seed:verify": "npx convex run seed:seedVerify",
    "dev:token": "tsx scripts/get-signin-token.ts",
    "test": "vitest run --passWithNoTests",
    "test:full": "vitest run --passWithNoTests",
    "test:quick": "vitest run --passWithNoTests --tags-filter='!slow'",
    "test:focus": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "i18n:verify": "node scripts/verify-i18n-keys.mjs",
    "test:e2e": "npx playwright test",
    "test:e2e:isolated": "bash scripts/e2e-preview.sh",
    "test:e2e:quick": "npm run seed:force && npx playwright test"
  },
  "dependencies": {
    "@clerk/nextjs": "7.0.4",
    "@dnd-kit/abstract": "^0.3.2",
    "@dnd-kit/dom": "^0.3.2",
    "@dnd-kit/react": "^0.3.2",
    "@dnd-kit/state": "^0.3.2",
    "@serwist/next": "^9.5.7",
    "@vis.gl/react-google-maps": "^1.7.1",
    "convex": "1.32.0",
    "libphonenumber-js": "^1.12.40",
    "lucide-react": "^0.577.0",
    "next": "^16.2.1",
    "next-intl": "4.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "serwist": "^9.5.7",
    "sonner": "^2.0.7",
    "use-places-autocomplete": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@axe-core/react": "^4.11.1",
    "@next/bundle-analyzer": "^16.2.2",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "axe-core": "^4.11.1",
    "convex-test": "^0.0.41",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
