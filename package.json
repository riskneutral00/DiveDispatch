{
  "name": "dive-dispatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev-auto.sh",
    "dev:port": "next dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "npm run seed:force",
    "seed:force": "npx convex run seed:wipeAll && npx convex dev --once && npm run gen:seed-slugs && npx convex run seed:seedAll && tsx scripts/seed-clerk.ts --force && npx convex run seed:seedVerify",
    "seed:clerk": "tsx scripts/seed-clerk.ts",
    "clerk:jwt-template": "tsx scripts/ensure-jwt-template.ts",
    "seed:verify": "npx convex run seed:seedVerify",
    "gen:seed-slugs": "tsx scripts/gen-seed-slugs.ts",
    "dev:token": "tsx scripts/get-signin-token.ts",
    "test": "vitest run --passWithNoTests",
    "test:full": "vitest run --passWithNoTests",
    "test:quick": "vitest run --passWithNoTests --tags-filter='!slow'",
    "test:focus": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "design:audit": "node scripts/design-audit.mjs",
    "i18n:verify": "node scripts/verify-i18n-keys.mjs",
    "i18n:audit": "node scripts/verify-i18n-keys.mjs",
    "i18n:translate": "node scripts/translate-locale-deltas.mjs",
    "i18n:check-usage": "node scripts/verify-i18n-usage.mjs",
    "validate:canonical": "bash scripts/validate-canonical.sh",
    "test:e2e": "npx playwright test",
    "test:e2e:isolated": "bash scripts/e2e-preview.sh",
    "test:e2e:quick": "npm run seed:force && npx playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.2.3",
    "@dnd-kit/abstract": "^0.4.0",
    "@dnd-kit/dom": "^0.4.0",
    "@dnd-kit/react": "^0.4.0",
    "@dnd-kit/state": "^0.4.0",
    "@internationalized/date": "^3.12.1",
    "@serwist/next": "^9.5.7",
    "@vis.gl/react-google-maps": "^1.8.3",
    "clsx": "^2.1.1",
    "convex": "^1.35.1",
    "i18n-iso-countries": "^7.14.0",
    "libphonenumber-js": "^1.12.41",
    "lucide-react": "^1.8.0",
    "mrz": "^5.0.2",
    "next": "^16.2.4",
    "next-intl": "^4.9.1",
    "posthog-js": "^1.369.3",
    "react": "^19.2.5",
    "react-aria-components": "^1.17.0",
    "react-dom": "^19.2.5",
    "react-phone-number-input": "^3.4.16",
    "serwist": "^9.5.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "use-places-autocomplete": "^4.0.1",
    "world-countries": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@axe-core/react": "^4.11.2",
    "@chromatic-com/storybook": "^5.1.2",
    "@clerk/testing": "^2.0.17",
    "@eslint/compat": "^2.0.5",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/nextjs-vite": "^10.3.5",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "ajv-cli": "5.0.0",
    "ajv-formats": "3.0.1",
    "axe-core": "^4.11.3",
    "chromatic": "^16.3.0",
    "convex-test": "^0.0.49",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.4",
    "eslint-plugin-storybook": "^10.3.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "playwright": "^1.59.1",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
