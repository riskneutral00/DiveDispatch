# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex auth (Clerk issuer URL)
CLERK_ISSUER_URL=

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend — set in Convex dashboard env vars, not .env.local)
RESEND_API_KEY=
# Used by Convex actions to construct portal URLs (no NEXT_PUBLIC_ prefix — Convex env var)
SITE_URL=https://yourdomain.com

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Development
DEV_MODE=true
