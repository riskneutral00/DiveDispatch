# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEV_MODE=true

# Email (Resend — also set in Convex dashboard env vars)
RESEND_API_KEY=
# Used by Convex actions to construct portal URLs (no NEXT_PUBLIC_ prefix — Convex env var)
SITE_URL=https://yourdomain.com

# ── Convex Dashboard Env Vars (set in Convex dashboard, NOT in .env.local) ──
# CLERK_WEBHOOK_SECRET=whsec_...    (Clerk webhook verification — required for user sync)
# MEDICAL_ENCRYPTION_KEY=...         (AES-256-GCM key for medical data — required for portal)

# PostHog (optional — analytics/error tracking disabled when unset)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
