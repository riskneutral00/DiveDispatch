{
  "hooks": {
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/teammate-idle.sh",
            "timeout": 10,
            "statusMessage": "Checking teammate status…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/login-slug-resolver.sh",
            "timeout": 15,
            "statusMessage": "Checking for login request…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gate-on-commit.sh",
            "timeout": 10,
            "statusMessage": "Checking gate status…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/commit-message-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking commit message…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tsc-pre-commit.sh",
            "timeout": 30,
            "statusMessage": "Type-checking staged files…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/test-colocation-check.sh",
            "timeout": 5,
            "statusMessage": "Checking test co-location…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dependency-audit.sh",
            "timeout": 15,
            "statusMessage": "Auditing npm dependencies…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/i18n-pre-commit.sh",
            "timeout": 15,
            "statusMessage": "Verifying i18n key parity…"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/middleware-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking file path…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking infrastructure scripts…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/spec-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ticket write authorization…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/css-file-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking CSS file creation…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/app-component-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking app/ component placement…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/frontmatter-guard.sh",
            "timeout": 3,
            "statusMessage": "Checking vault frontmatter…"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/middleware-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking file path…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking infrastructure scripts…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/spec-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ticket write authorization…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/css-file-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking CSS file creation…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/frontmatter-guard.sh",
            "timeout": 3,
            "statusMessage": "Checking vault frontmatter…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/skill-usage-logger.sh",
            "timeout": 5,
            "statusMessage": "Logging skill usage…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/turbopack-cache-clean.sh",
            "timeout": 5,
            "statusMessage": "Clearing Turbopack cache…"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/design-validation-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking design files…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/schema-preflight.sh",
            "timeout": 5,
            "statusMessage": "Checking schema changes…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dependency-direction.sh",
            "timeout": 5,
            "statusMessage": "Checking dependency direction…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/provider-nesting.sh",
            "timeout": 5,
            "statusMessage": "Checking provider order…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tsc-post-edit.sh",
            "timeout": 30,
            "statusMessage": "Type-checking edited file…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/n-plus-one-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for N+1 patterns…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/unbounded-query-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking query bounds…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/skeleton-stale-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking skeleton freshness…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dry-check.sh",
            "timeout": 5,
            "statusMessage": "Checking for DRY violations…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/glass-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking glass system compliance…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/design-token-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking design tokens + mobile-first…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/type-scale-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking type scale tokens…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/route-component-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking route page components…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/inline-style-drift.sh",
            "timeout": 5,
            "statusMessage": "Checking inline style drift…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/date-formatter-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking date formatter duplication…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/raw-input-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking raw <input> primitives…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dialog-title-i18n.sh",
            "timeout": 5,
            "statusMessage": "Checking dialog i18n…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/local-type-alias-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking local type alias drift…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/style-classname-boundary.sh",
            "timeout": 5,
            "statusMessage": "Checking style↔className boundary…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/i18n-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking i18n patterns…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/fsm-status-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking FSM status transitions…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/auth-gateway-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking auth gateway usage…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/error-shape-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ConvexError shape…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/convex-error-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking structured errors…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/empty-catch-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking empty catch blocks…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/playwright-wait-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking Playwright wait patterns…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/weak-assertion-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking test assertion strength…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/error-i18n-sync.sh",
            "timeout": 5,
            "statusMessage": "Checking ErrorCode ↔ i18n sync…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/no-comments-guard.sh",
            "timeout": 10,
            "statusMessage": "No-comments guard"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/mobile-viewport-check.sh",
            "timeout": 10,
            "statusMessage": "Checking mobile-first viewport contract…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/overflow-scroll-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking intrinsic containment…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/console-ban-convex.sh",
            "timeout": 5,
            "statusMessage": "Checking structured logging…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/error-boundary-reporting.sh",
            "timeout": 5,
            "statusMessage": "Checking error reporting…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/route-error-boundary.sh",
            "timeout": 5,
            "statusMessage": "Checking error boundary coverage…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/rate-limit-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking rate limiting…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/raw-button-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking raw button usage…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/raw-primitive-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking raw <select>/<textarea>/<label>/<dialog> usage…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/primitive-asterisk-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking required-asterisk primitive usage…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/touch-target-literal.sh",
            "timeout": 5,
            "statusMessage": "Checking touch-target literals…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/throw-error-i18n.sh",
            "timeout": 5,
            "statusMessage": "Checking throw Error i18n…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/spacing-ladder-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking spacing ladder…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/empty-state-i18n.sh",
            "timeout": 5,
            "statusMessage": "Checking EmptyState i18n…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/anyctx-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for AnyCtx / as any…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tdd-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking TDD — sibling test exists…"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/precompact-archive.sh",
            "timeout": 10,
            "statusMessage": "Archiving context before compaction…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-vault-context.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
