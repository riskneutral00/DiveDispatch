{
  "hooks": {
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/teammate-idle.sh",
            "timeout": 10,
            "statusMessage": "Checking teammate status…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/login-slug-resolver.sh",
            "timeout": 15,
            "statusMessage": "Checking for login request…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/commit-message-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking commit message…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tsc-pre-commit.sh",
            "timeout": 30,
            "statusMessage": "Type-checking staged files…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/test-colocation-check.sh",
            "timeout": 5,
            "statusMessage": "Checking test co-location…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dependency-audit.sh",
            "timeout": 15,
            "statusMessage": "Auditing npm dependencies…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/i18n-pre-commit.sh",
            "timeout": 15,
            "statusMessage": "Verifying i18n key parity…"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/middleware-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking file path…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking infrastructure scripts…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/spec-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ticket write authorization…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/css-file-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking CSS file creation…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/app-component-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking app/ component placement…"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/middleware-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking file path…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking infrastructure scripts…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/spec-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ticket write authorization…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/css-file-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking CSS file creation…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/skill-usage-logger.sh",
            "timeout": 5,
            "statusMessage": "Logging skill usage…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/turbopack-cache-clean.sh",
            "timeout": 5,
            "statusMessage": "Clearing Turbopack cache…"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/design-validation-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking design files…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/schema-preflight.sh",
            "timeout": 5,
            "statusMessage": "Checking schema changes…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dependency-direction.sh",
            "timeout": 5,
            "statusMessage": "Checking dependency direction…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/provider-nesting.sh",
            "timeout": 5,
            "statusMessage": "Checking provider order…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tsc-post-edit.sh",
            "timeout": 30,
            "statusMessage": "Type-checking edited file…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/n-plus-one-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for N+1 patterns…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/skeleton-stale-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking skeleton freshness…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dry-check.sh",
            "timeout": 5,
            "statusMessage": "Checking for DRY violations…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/glass-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking glass system compliance…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/design-token-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking design tokens + mobile-first…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/type-scale-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking type scale tokens…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/route-component-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking route page components…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/inline-style-drift.sh",
            "timeout": 5,
            "statusMessage": "Checking inline style drift…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/style-classname-boundary.sh",
            "timeout": 5,
            "statusMessage": "Checking style↔className boundary…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/i18n-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking i18n patterns…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/fsm-status-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking FSM status transitions…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/error-shape-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ConvexError shape…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/error-i18n-sync.sh",
            "timeout": 5,
            "statusMessage": "Checking ErrorCode ↔ i18n sync…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/no-comments-guard.sh",
            "timeout": 10,
            "statusMessage": "No-comments guard"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/precompact-archive.sh",
            "timeout": 10,
            "statusMessage": "Archiving context before compaction…"
          }
        ]
      }
    ]
  }
}
