{
  "hooks": {
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/teammate-idle.sh",
            "timeout": 10,
            "statusMessage": "Checking teammate status\u2026"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/login-slug-resolver.sh",
            "timeout": 15,
            "statusMessage": "Checking for login request\u2026"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gate-on-commit.sh",
            "timeout": 10,
            "statusMessage": "Checking gate status\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/commit-message-gate.sh",
            "timeout": 5,
            "statusMessage": "Checking commit message\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tsc-pre-commit.sh",
            "timeout": 30,
            "statusMessage": "Type-checking staged files\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/test-colocation-check.sh",
            "timeout": 5,
            "statusMessage": "Checking test co-location\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dependency-audit.sh",
            "timeout": 15,
            "statusMessage": "Auditing npm dependencies\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/i18n-pre-commit.sh",
            "timeout": 15,
            "statusMessage": "Verifying i18n key parity\u2026"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/middleware-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking file path\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking infrastructure scripts\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/spec-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ticket write authorization\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/css-file-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking CSS file creation\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/app-component-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking app/ component placement\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/frontmatter-guard.sh",
            "timeout": 3,
            "statusMessage": "Checking vault frontmatter\u2026"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/middleware-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking file path\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scripts-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking infrastructure scripts\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/spec-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ticket write authorization\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/css-file-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking CSS file creation\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/frontmatter-guard.sh",
            "timeout": 3,
            "statusMessage": "Checking vault frontmatter\u2026"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/skill-usage-logger.sh",
            "timeout": 5,
            "statusMessage": "Logging skill usage\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/turbopack-cache-clean.sh",
            "timeout": 5,
            "statusMessage": "Clearing Turbopack cache\u2026"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/design-validation-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking design files\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/schema-preflight.sh",
            "timeout": 5,
            "statusMessage": "Checking schema changes\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dependency-direction.sh",
            "timeout": 5,
            "statusMessage": "Checking dependency direction\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/provider-nesting.sh",
            "timeout": 5,
            "statusMessage": "Checking provider order\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tsc-post-edit.sh",
            "timeout": 30,
            "statusMessage": "Type-checking edited file\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/n-plus-one-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for N+1 patterns\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/unbounded-query-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking query bounds\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/skeleton-stale-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking skeleton freshness\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dry-check.sh",
            "timeout": 5,
            "statusMessage": "Checking for DRY violations\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/glass-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking glass system compliance\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/design-token-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking design tokens + mobile-first\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/type-scale-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking type scale tokens\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/route-component-enforcement.sh",
            "timeout": 5,
            "statusMessage": "Checking route page components\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/inline-style-drift.sh",
            "timeout": 5,
            "statusMessage": "Checking inline style drift\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/date-formatter-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking date formatter duplication\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/raw-input-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking raw <input> primitives\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/dialog-title-i18n.sh",
            "timeout": 5,
            "statusMessage": "Checking dialog i18n\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/local-type-alias-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking local type alias drift\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/style-classname-boundary.sh",
            "timeout": 5,
            "statusMessage": "Checking style\u2194className boundary\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/i18n-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking i18n patterns\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/fsm-status-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking FSM status transitions\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/auth-gateway-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking auth gateway usage\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/error-shape-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking ConvexError shape\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/convex-error-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking structured errors\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/empty-catch-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking empty catch blocks\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/playwright-wait-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking Playwright wait patterns\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/weak-assertion-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking test assertion strength\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/error-i18n-sync.sh",
            "timeout": 5,
            "statusMessage": "Checking ErrorCode \u2194 i18n sync\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/no-comments-guard.sh",
            "timeout": 10,
            "statusMessage": "No-comments guard"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/mobile-viewport-check.sh",
            "timeout": 10,
            "statusMessage": "Checking mobile-first viewport contract\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/overflow-scroll-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking intrinsic containment\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/console-ban-convex.sh",
            "timeout": 5,
            "statusMessage": "Checking structured logging\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/error-boundary-reporting.sh",
            "timeout": 5,
            "statusMessage": "Checking error reporting\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/route-error-boundary.sh",
            "timeout": 5,
            "statusMessage": "Checking error boundary coverage\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/rate-limit-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking rate limiting\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/raw-button-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking raw button usage\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/raw-primitive-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking raw <select>/<textarea>/<label>/<dialog> usage\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/primitive-asterisk-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking required-asterisk primitive usage\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/touch-target-literal.sh",
            "timeout": 5,
            "statusMessage": "Checking touch-target literals\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/throw-error-i18n.sh",
            "timeout": 5,
            "statusMessage": "Checking throw Error i18n\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/spacing-ladder-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking spacing ladder\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/empty-state-i18n.sh",
            "timeout": 5,
            "statusMessage": "Checking EmptyState i18n\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/anyctx-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking for AnyCtx / as any\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/tdd-guard.sh",
            "timeout": 5,
            "statusMessage": "Checking TDD \u2014 sibling test exists\u2026"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/vi-mock-convex-react-blocker.sh",
            "timeout": 5,
            "statusMessage": "Checking for vi.mock('convex/react')\u2026"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/precompact-archive.sh",
            "timeout": 10,
            "statusMessage": "Archiving context before compaction\u2026"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-vault-context.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_wait_for"
    ]
  }
}
