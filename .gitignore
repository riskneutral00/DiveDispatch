# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# tickets (working items for parallel Claude terminals)
.tickets/

# lifecycle sentinel files (written by /last and /gate, consumed by /vault)
.last-ran
.gate-ran
.vitest-last-pass

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Serwist service worker build output
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map
# Next.js 16 renamed middleware → proxy. Block the deprecated file.
src/middleware.ts
# Static role dirs replaced by dynamic [roleSlug] route (commit 0254168).
# Leftover static dirs shadow the dynamic route, losing DashboardShell layout.
src/app/(dashboard)/[slug]/agent/
src/app/(dashboard)/[slug]/boat/
src/app/(dashboard)/[slug]/compressor/
src/app/(dashboard)/[slug]/dive-center/
src/app/(dashboard)/[slug]/dive-master/
src/app/(dashboard)/[slug]/equipment/
src/app/(dashboard)/[slug]/instructor/
src/app/(dashboard)/[slug]/pool/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# convex generated
convex/_generated/

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
.claude/session.md
.playwright-mcp/

# screenshots
/*.png
screenshots/
test-results/
playwright-report/

# Temporary patch files
.patches/

# Stale skill versions (only SKILL.md is canonical)
.claude/skills/**/skill *.md

# Internal AI tooling (keep locally, not public)
.mulch/
.overstory/
.jira/
docs/LLM_HANDOFF.md

# clerk configuration (can include secrets)
/.clerk/
