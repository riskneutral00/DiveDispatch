{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://divedispatch.local/ultraplan/canonical.schema.json",
  "title": "DiveDispatch Happy-Path Canonical Ledger",
  "description": "Product-intent-driven canonical field shapes for every stakeholder in the happy path. Wave 4 update: ISO 3166-1 alpha-2 countries, E.164 phones, structured address, collapsed deliberate-incomplete pairs, promoted slug + clerkUserIdHint + clerkOrgIdHint. Handwritten — NOT auto-derived from convex/schema.ts.",
  "type": "object",
  "required": ["order", "stakeholders"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "order": {
      "type": "array",
      "description": "Creation order for the happy-path run. Drives Act I phase sequence.",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "stakeholders": {
      "type": "object",
      "description": "Keyed by canonical stakeholder id (e.g. compressor_1, dive_center_2).",
      "additionalProperties": { "$ref": "#/$defs/stakeholderEntry" }
    },
    "admin_venues": {
      "type": "object",
      "description": "Admin-added venues. Owned by an area org (e.g. `south-andaman`) and seeded via that org's `venues[]` block.",
      "additionalProperties": { "$ref": "#/$defs/adminVenueEntry" }
    }
  },
  "$defs": {
    "stakeholderEntry": {
      "oneOf": [
        { "$ref": "#/$defs/entryCompressor" },
        { "$ref": "#/$defs/entryEquipment" },
        { "$ref": "#/$defs/entryBoat" },
        { "$ref": "#/$defs/entryInstructor" },
        { "$ref": "#/$defs/entryPool" },
        { "$ref": "#/$defs/entryDiveCenter" },
        { "$ref": "#/$defs/entryAgent" },
        { "$ref": "#/$defs/entryCustomer" }
      ]
    },
    "phoneE164": {
      "type": "string",
      "pattern": "^\\+[1-9]\\d{1,14}$",
      "description": "E.164 format: leading +, country code, national number, no spaces/hyphens."
    },
    "isoCountryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country code, uppercase."
    },
    "supportedLocale": {
      "type": "string",
      "enum": ["en", "zh-CN", "zh-TW", "th", "fr", "ko"],
      "description": "UI locale; must be a supported translation."
    },
    "address": {
      "type": "object",
      "required": ["city", "country"],
      "additionalProperties": false,
      "properties": {
        "street": { "type": "string" },
        "city": { "type": "string", "minLength": 1 },
        "state": { "type": "string" },
        "country": { "$ref": "#/$defs/isoCountryCode" },
        "postalCode": { "type": "string" }
      }
    },
    "usersBlock": {
      "description": "Canonical per-user record. Mirrors `users` table but omits runtime-assigned tokenIdentifier. slug + clerkUserIdHint are authoritative for seed.",
      "type": "object",
      "required": ["email", "firstName", "lastName", "appLanguage", "dateOfBirth", "slug", "clerkUserIdHint"],
      "additionalProperties": false,
      "properties": {
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "firstName": { "type": "string", "minLength": 1 },
        "lastName": { "type": "string", "minLength": 1 },
        "nickname": { "type": "string" },
        "appLanguage": { "$ref": "#/$defs/supportedLocale" },
        "customerLanguages": { "type": "array", "items": { "type": "string" } },
        "phone": { "$ref": "#/$defs/phoneE164" },
        "dateOfBirth": { "type": "string", "description": "ISO date." },
        "defaultLocation": { "type": "string" },
        "slug": { "type": "string", "minLength": 1 },
        "clerkUserIdHint": { "type": "string", "minLength": 1 }
      }
    },
    "accessControl": {
      "description": "isAllowed / notAllowed. Role-specific — Compressor defers, Equipment/Pool use. Defaults to [] when absent.",
      "type": "object",
      "properties": {
        "isAllowed": { "type": "array", "items": { "type": "string" } },
        "notAllowed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "locationBlock": {
      "type": "object",
      "required": ["address", "lat", "lng"],
      "properties": {
        "address": { "$ref": "#/$defs/address" },
        "placeId": { "type": "string" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "credential": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agency", "level", "agencyID"],
        "properties": {
          "agency": { "type": "string", "enum": ["PADI", "SSI", "SDI", "NAUI", "RAID", "BSAC", "CMAS", "TDI"] },
          "level": { "type": "string" },
          "agencyID": { "type": "string" },
          "specialtyRatings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "vessel": {
      "type": "object",
      "required": ["name", "maxPax", "type", "routes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "maxPax": { "type": "integer", "minimum": 1 },
        "type": { "type": "string", "enum": ["day_boat", "liveaboard", "rib", "longtail", "speedboat"] },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["diveSite", "daysOfWeek"],
            "properties": {
              "diveSite": { "type": "string" },
              "daysOfWeek": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "entryCompressor": {
      "type": "object",
      "required": ["role", "compressors", "clerkOrgIdHint"],
      "properties": {
        "role": { "const": "Compressor" },
        "slugRef": { "type": "string" },
        "note": { "type": "string" },
        "clerkOrgIdHint": { "type": "string", "minLength": 1 },
        "users": { "$ref": "#/$defs/usersBlock" },
        "compressors": {
          "allOf": [
            { "$ref": "#/$defs/locationBlock" },
            { "$ref": "#/$defs/accessControl" },
            {
              "type": "object",
              "required": ["name", "email", "phone", "verified"],
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "phone": { "$ref": "#/$defs/phoneE164" },
                "gasMixes": { "type": "array", "items": { "type": "string", "enum": ["air", "nitrox"] }, "minItems": 1 },
                "nitroxMin": { "type": "integer", "minimum": 22, "maximum": 40 },
                "nitroxMax": { "type": "integer", "minimum": 22, "maximum": 40 },
                "verified": { "type": "boolean" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "entryEquipment": {
      "type": "object",
      "required": ["role", "equipment", "clerkOrgIdHint"],
      "properties": {
        "role": { "const": "Equipment" },
        "slugRef": { "type": "string" },
        "note": { "type": "string" },
        "clerkOrgIdHint": { "type": "string", "minLength": 1 },
        "users": { "$ref": "#/$defs/usersBlock" },
        "equipment": {
          "allOf": [
            { "$ref": "#/$defs/locationBlock" },
            { "$ref": "#/$defs/accessControl" },
            {
              "type": "object",
              "required": ["name", "email", "phone", "verified"],
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "phone": { "$ref": "#/$defs/phoneE164" },
                "manufacturersByGearType": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
                },
                "verified": { "type": "boolean" }
              }
            }
          ]
        },
        "inventoryOverrides": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entryBoat": {
      "type": "object",
      "required": ["role", "boats", "clerkOrgIdHint"],
      "properties": {
        "role": { "const": "Boat" },
        "slugRef": { "type": "string" },
        "note": { "type": "string" },
        "clerkOrgIdHint": { "type": "string", "minLength": 1 },
        "users": { "$ref": "#/$defs/usersBlock" },
        "boats": {
          "allOf": [
            { "$ref": "#/$defs/locationBlock" },
            { "$ref": "#/$defs/accessControl" },
            {
              "type": "object",
              "required": ["name", "email", "phone", "hasCompressor", "verified"],
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "phone": { "$ref": "#/$defs/phoneE164" },
                "vessels": { "type": "array", "items": { "$ref": "#/$defs/vessel" }, "minItems": 1 },
                "hasCompressor": { "type": "boolean" },
                "verified": { "type": "boolean" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "entryInstructor": {
      "type": "object",
      "required": ["role", "instructors", "clerkOrgIdHint"],
      "properties": {
        "role": { "const": "Instructor" },
        "slugRef": { "type": "string" },
        "label": { "type": "string" },
        "note": { "type": "string" },
        "clerkOrgIdHint": { "type": "string", "minLength": 1 },
        "users": { "$ref": "#/$defs/usersBlock" },
        "instructors": {
          "allOf": [
            { "$ref": "#/$defs/locationBlock" },
            { "$ref": "#/$defs/accessControl" },
            {
              "type": "object",
              "required": ["name", "email", "phone", "credential", "verified"],
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "phone": { "$ref": "#/$defs/phoneE164" },
                "credential": { "$ref": "#/$defs/credential" },
                "teachingLanguages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "verified": { "type": "boolean" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "entryPool": {
      "type": "object",
      "required": ["role", "venues", "clerkOrgIdHint"],
      "properties": {
        "role": { "const": "Venue" },
        "slugRef": { "type": "string" },
        "note": { "type": "string" },
        "clerkOrgIdHint": { "type": "string", "minLength": 1 },
        "users": { "$ref": "#/$defs/usersBlock" },
        "venues": {
          "allOf": [
            { "$ref": "#/$defs/locationBlock" },
            { "$ref": "#/$defs/accessControl" },
            {
              "type": "object",
              "required": ["name", "subtype", "hasCompressor", "verified"],
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "phone": { "$ref": "#/$defs/phoneE164" },
                "subtype": { "type": "string", "enum": ["pool", "shore", "reef", "lake", "river", "quarry", "other"] },
                "maxDepth": { "type": "number", "minimum": 0 },
                "maxCapacity": { "type": "integer", "minimum": 1 },
                "confinedCapable": { "type": "boolean" },
                "hasCompressor": { "type": "boolean" },
                "verified": { "type": "boolean" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "entryDiveCenter": {
      "type": "object",
      "required": ["role", "diveCenters", "clerkOrgIdHint"],
      "properties": {
        "role": { "const": "DiveCenter" },
        "slugRef": { "type": "string" },
        "note": { "type": "string" },
        "clerkOrgIdHint": { "type": "string", "minLength": 1 },
        "users": { "$ref": "#/$defs/usersBlock" },
        "diveCenters": {
          "allOf": [
            { "$ref": "#/$defs/locationBlock" },
            { "$ref": "#/$defs/accessControl" },
            {
              "type": "object",
              "required": ["name", "email", "phone", "customerLanguages", "associations", "verified"],
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "phone": { "$ref": "#/$defs/phoneE164" },
                "associations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["agency", "number"],
                    "properties": {
                      "agency": { "type": "string" },
                      "number": { "type": "string" },
                      "owDays": { "type": "integer", "minimum": 1 },
                      "aowDays": { "type": "integer", "minimum": 1 },
                      "oaDays": { "type": "integer", "minimum": 1 },
                      "selectedSpecialties": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                },
                "customerLanguages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "verified": { "type": "boolean" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "entryAgent": {
      "type": "object",
      "required": ["role", "agents", "clerkOrgIdHint"],
      "properties": {
        "role": { "const": "Agent" },
        "slugRef": { "type": "string" },
        "note": { "type": "string" },
        "clerkOrgIdHint": { "type": "string", "minLength": 1 },
        "users": { "$ref": "#/$defs/usersBlock" },
        "agents": {
          "allOf": [
            { "$ref": "#/$defs/locationBlock" },
            { "$ref": "#/$defs/accessControl" },
            {
              "type": "object",
              "required": ["name", "email", "phone", "customerLanguages", "verified"],
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string", "format": "email" },
                "phone": { "$ref": "#/$defs/phoneE164" },
                "associations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["agency", "number"],
                    "properties": {
                      "agency": { "type": "string" },
                      "number": { "type": "string" }
                    }
                  }
                },
                "customerLanguages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "verified": { "type": "boolean" }
              }
            }
          ]
        },
        "stakeholderPreferences": {
          "type": "object",
          "properties": {
            "preferredOperatorSlug": { "type": "string" }
          }
        }
      },
      "additionalProperties": false
    },
    "entryCustomer": {
      "type": "object",
      "description": "Customer — token-auth portal. No Clerk user, no org. Simpler than stakeholder entries.",
      "required": ["role"],
      "properties": {
        "role": { "const": "Customer" },
        "note": { "type": "string" },
        "customer": {
          "type": "object",
          "required": ["firstName", "lastName", "email", "phone", "dateOfBirth", "certLevel", "medicalFlag", "languages"],
          "properties": {
            "firstName": { "type": "string", "minLength": 1 },
            "lastName": { "type": "string", "minLength": 1 },
            "email": { "type": "string", "format": "email" },
            "phone": { "$ref": "#/$defs/phoneE164" },
            "dateOfBirth": { "type": "string" },
            "certLevel": { "type": "string" },
            "medicalFlag": { "type": "boolean" },
            "emergencyContact": {
              "type": "object",
              "required": ["name", "phone", "relationship"],
              "properties": {
                "name": { "type": "string" },
                "phone": { "$ref": "#/$defs/phoneE164" },
                "relationship": { "type": "string" }
              }
            },
            "languages": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "sizing": {
              "type": "object",
              "properties": {
                "wetsuit": { "type": "string" },
                "bcd": { "type": "string" },
                "regulator": { "type": "string" },
                "fins": { "type": "string" },
                "mask": { "type": "string" },
                "height": { "type": "number" },
                "weight": { "type": "number" }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "adminVenueEntry": {
      "type": "object",
      "required": ["category", "venues", "inventoryUnits"],
      "properties": {
        "category": { "const": "AdminVenue" },
        "note": { "type": "string" },
        "venues": {
          "allOf": [
            { "$ref": "#/$defs/locationBlock" },
            { "$ref": "#/$defs/accessControl" },
            {
              "type": "object",
              "required": ["name", "subtype", "hasCompressor", "verified"],
              "properties": {
                "name": { "type": "string" },
                "email": { "type": "string" },
                "phone": { "type": "string" },
                "subtype": { "type": "string", "enum": ["pool", "shore", "reef", "lake", "river", "quarry", "other"] },
                "confinedCapable": { "type": "boolean" },
                "hasCompressor": { "type": "boolean" },
                "maxCapacity": { "type": "integer", "minimum": 1 },
                "maxDepth": { "type": "number" },
                "verified": { "const": true }
              }
            }
          ]
        },
        "inventoryUnits": {
          "type": "object",
          "required": ["resourceType", "resourceId", "displayName", "capacityModel", "totalUnits", "ownerId", "ownerType"],
          "properties": {
            "resourceType": { "type": "string", "enum": ["Venue", "Boat"] },
            "resourceId": { "type": "string" },
            "displayName": { "type": "string" },
            "capacityModel": { "type": "string", "enum": ["Pooled", "Exclusive"] },
            "totalUnits": { "type": "integer", "minimum": 1 },
            "ownerId": { "const": "__unowned__" },
            "ownerType": { "const": "Venue" }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
